---
import DomainPlaceholder from "./DomainPlaceholder.astro";

interface Props {
  href: string;
  image?: string;
  placeholderDomaine?: string;
  tag?: string;
  title: string;
  excerpt?: string;
  meta?: string;
}

const { href, image, placeholderDomaine, tag, title, excerpt, meta } = Astro.props;
---

<a href={href} class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-navy-900/5 transition hover:-translate-y-1 hover:shadow-lg">
  <div class="aspect-[4/3] w-full overflow-hidden bg-navy-100">
    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        width="480"
        height="360"
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
    ) : (
      <DomainPlaceholder domaine={placeholderDomaine ?? title} />
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    {tag && <span class="mb-2 w-fit rounded-full bg-navy-900/5 px-3 py-1 text-xs font-semibold text-navy-800">{tag}</span>}
    <h3 class="font-heading text-lg font-bold text-navy-950 group-hover:text-navy-700">{title}</h3>
    {excerpt && <p class="mt-2 text-sm text-navy-700 line-clamp-3">{excerpt}</p>}
    {meta && <p class="mt-3 text-xs font-medium text-navy-500">{meta}</p>}
  </div>
</a>
