---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const cycles = await getCollection("cycles");
  return cycles.map((c) => ({
    params: { slug: c.data.slug },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titre, description, image, programme, debouches, duree } = entry.data;
---

<BaseLayout title={titre} description={description}>
  <section class="bg-navy-950 py-16 text-cream-50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a href="/formation-professionnelle" class="text-sm text-gold-500 hover:underline">← Formation professionnelle</a>
      <h1 class="mt-4 font-heading text-4xl font-bold sm:text-5xl">{titre}</h1>
      <p class="mt-4 text-cream-200">{description}</p>
      <p class="mt-4 inline-block rounded-full bg-gold-500 px-4 py-1.5 text-sm font-semibold text-navy-950">{duree}</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    {image && <img src={image} alt={titre} class="mb-10 aspect-video w-full rounded-2xl object-cover shadow" loading="lazy" />}

    <div class="prose max-w-none prose-headings:font-heading prose-headings:text-navy-950 prose-a:text-navy-700 prose-strong:text-navy-900">
      <Content />
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {programme.length > 0 && (
        <div>
          <h2 class="font-heading text-lg font-bold text-navy-950">Programme</h2>
          <ul class="mt-3 space-y-2 text-navy-700">
            {programme.map((p) => <li class="flex gap-2"><span class="text-gold-600">✓</span> {p}</li>)}
          </ul>
        </div>
      )}
      {debouches.length > 0 && (
        <div>
          <h2 class="font-heading text-lg font-bold text-navy-950">Débouchés</h2>
          <ul class="mt-3 space-y-2 text-navy-700">
            {debouches.map((d) => <li class="flex gap-2"><span class="text-gold-600">✓</span> {d}</li>)}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-12 rounded-2xl bg-cream-100 p-8 text-center">
      <h3 class="font-heading text-xl font-bold text-navy-950">Intéressé(e) par ce parcours ?</h3>
      <div class="mt-6 flex flex-col justify-center gap-4 sm:flex-row">
        <Button href="/filieres">Voir les filières</Button>
        <Button href="/contact" variant="secondary">Je m'inscris</Button>
      </div>
    </div>
  </section>
</BaseLayout>
