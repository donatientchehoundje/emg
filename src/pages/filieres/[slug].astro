---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import DomainPlaceholder from "../../components/DomainPlaceholder.astro";
import Card from "../../components/Card.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const filieres = await getCollection("filieres");
  return filieres.map((f) => ({
    params: { slug: f.id },
    props: { entry: f, all: filieres },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { titre, domaine, imagePrincipale, descriptionCourte, duree, certification, niveauAdmission, debouches } = entry.data;

const autresFilieres = all
  .filter((f) => f.data.domaine === domaine && f.id !== entry.id)
  .slice(0, 3);
---

<BaseLayout title={titre} description={descriptionCourte}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/filieres" class="text-sm font-medium text-navy-700 hover:underline">← Toutes les filières</a>

    <div class="mt-6 grid gap-10 md:grid-cols-2 md:items-start">
      <div class="aspect-[4/3] overflow-hidden rounded-2xl shadow-lg">
        {imagePrincipale ? (
          <img src={imagePrincipale} alt={titre} class="h-full w-full object-cover" loading="lazy" />
        ) : (
          <DomainPlaceholder domaine={domaine} />
        )}
      </div>

      <div>
        <span class="rounded-full bg-navy-900/5 px-3 py-1 text-xs font-semibold text-navy-800">{domaine}</span>
        <h1 class="mt-3 font-heading text-3xl font-bold text-navy-950 sm:text-4xl">{titre}</h1>
        <p class="mt-4 text-navy-700">{descriptionCourte}</p>

        <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="font-semibold text-navy-900">Durée</dt>
            <dd class="text-navy-700">{duree}</dd>
          </div>
          <div>
            <dt class="font-semibold text-navy-900">Admission</dt>
            <dd class="text-navy-700">{niveauAdmission}</dd>
          </div>
          <div class="col-span-2">
            <dt class="font-semibold text-navy-900">Certification(s)</dt>
            <dd class="mt-1 flex flex-wrap gap-2">
              {certification.map((c) => <span class="rounded-full bg-gold-500/15 px-3 py-1 text-xs font-semibold text-gold-600">{c}</span>)}
            </dd>
          </div>
        </dl>

        <div class="mt-8">
          <Button href="/contact">Je m'inscris à cette filière</Button>
        </div>
      </div>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      <div class="md:col-span-2 prose max-w-none prose-headings:font-heading prose-headings:text-navy-950 prose-a:text-navy-700 prose-strong:text-navy-900">
        <Content />
      </div>
      {debouches.length > 0 && (
        <div>
          <h2 class="font-heading text-lg font-bold text-navy-950">Débouchés</h2>
          <ul class="mt-3 space-y-2 text-navy-700">
            {debouches.map((d) => <li class="flex gap-2"><span class="text-gold-600">✓</span> {d}</li>)}
          </ul>
        </div>
      )}
    </div>

    {autresFilieres.length > 0 && (
      <div class="mt-16">
        <h2 class="font-heading text-2xl font-bold text-navy-950">Autres filières en {domaine}</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {autresFilieres.map((f) => (
            <Card
              href={`/filieres/${f.id}`}
              image={f.data.imagePrincipale}
              placeholderDomaine={f.data.domaine}
              title={f.data.titre}
              excerpt={f.data.descriptionCourte}
            />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
